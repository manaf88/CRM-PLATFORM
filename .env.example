# DEFAULT_COMPANY_ID=
DEFAULT_COMPANY_NAME=Solutions
# ACCOUNT_MANAGER | COPYWRITER | DESIGNER | SOCIAL_MEDIA_MANAGER | CLIENT_OWNER | CLIENT_REVIEWER | SALES_AGENT
DEFAULT_MEMBER_ROLE=ACCOUNT_MANAGER